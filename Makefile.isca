# Build settings for the ISCA cluster (University of Exeter).
# Self-contained: works as "make -f Makefile.isca" or copied over Makefile on ISCA.
# NOTE: if you add a new source file, add it to OBJECTS here AND in the main Makefile.
#
# Usage on an ISCA login node:
#   module purge
#   module load foss/2019a h5py/2.9.0-foss-2019a
#   make -f Makefile.isca clean     (or "make clean" if copied to Makefile)
#   make -f Makefile.isca
#
# Differences from the local Makefile:
#   - no -pg profiling (gmon.out would be clobbered by every rank, and it slows the run)
#   - no -no-pie (only needed for the conda toolchain on the local workstation)
#   - h5pfc comes from the HDF5 module pulled in by h5py/2.9.0-foss-2019a

TARGET = a.out
OBJECTS = rand_compat.o Util_rot.o BMP_rot.o Matrix_rot.o \
	Globalvar.o Parameters.o MPI_rot.o Boundary_rot.o Scheme_rot.o \
	HC_rot.o \
	Res_rot.o Gra_rot.o PIP_rot.o Visc_rot.o\
	IOT_rot.o IO_rot.o   \
	HLL_rot.o Model_rot.o \
	Solver_rot.o\
	set_coordinate_NUG.o set_fold_grid.o \
	linear_wave.o  \
	shock_tube.o explosion.o currentsheet.o KH.o RT.o\
	Orszag_Tang.o FieldLoop.o ambipolar.o PNcoupling.o\
	HCtest.o HCtest_Tonly.o Flare.o Coalescence.o Sedov.o tearing.o \
	NUwave.o Reconnection.o BMP_density.o blob.o field_diffusion.o\
	CS_collapse.o asym_currentsheet.o CSC.o\
	Alfven_Damping.o cnd_tube.o shock_tube_ion.o\
	MRI.o disk_flare.o mass_load_prom.o KHnlev.o KHtube.o\
	Initial_rot.o  main.o relax_prom.o relax_prom2.o procedures.o hsstatic.o\
	resonator.o ionrectest.o  Complete_spectrum.o shock_tube_stab.o shock_tube_stab2.o \
	shock_tube_stab3.o shock_tube_photon.o kink_wave.o RMI.o kink_instability.o jetcrosssection.o HC_tests.o
MOD_FILES = rand_compat.mod util_rot.mod globalvar.mod parameters.mod \
	scheme_rot.mod hc_rot.mod \
	res_rot.mod gra_rot.mod pip_rot.mod visc_rot.mod\
	mpi_rot.mod io_rot.mod \
	hll_rot.mod model_rot.mod  \
	boundary_rot.mod solver_rot.mod matrix_rot.mod initial_rot.mod  procedures.mod

FC      = h5pfc
FFLAGS  = -O2
DEBUG   =
LDFLAGS =
LIB_DIR = .

.SUFFIXES : .o .f90
.f90.o:
	${FC} ${FFLAGS} ${DEBUG} -c $<


${TARGET} : ${OBJECTS}
	${FC} ${DEBUG} -L$(LIB_DIR) ${LDFLAGS} -o $@ ${OBJECTS}
#	rm ${OBJECTS} ${MOD_FILES}
clean:
	rm ${TARGET} ${OBJECTS} ${MOD_FILES}

datatidy:
	rm Data/*

print_vars:
	@echo "FC='${FC}'"
